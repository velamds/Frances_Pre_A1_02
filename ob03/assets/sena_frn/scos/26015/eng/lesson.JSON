", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "You have 2 tries.", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Keep trying.", "type": "text"}, {"content": "Maybe next time.", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes : Compl\u00e9tez les \u00e9tapes suivantes. Remplissez la grille d'auto-\u00e9valuation.", "type": "text"}]}], "type": "DWS", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "You have 2 tries.", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Try again.", "type": "text"}, {"content": "Maybe next time\u2026", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn1le02ob03re2img01.jpg"}, {"text": "<span class=\"strong\">\u00c9mile</span> : Gr\u00e9goire, ta petite amie est grecque, n'est-ce pas ? <br />\n<span class=\"strong\">Gr\u00e9goire</span> : Oui, elle a un passeport grec. <br />", "id": 1, "time": "0", "image": "frn1le02ob03re2img01.jpg"}, {"text": "<span class=\"strong\">\u00c9mile</span> : Est-ce que tu parles grec ? <br />\n<span class=\"strong\">Gr\u00e9goire</span> : Je parle un petit peu grec. <br />", "id": 2, "time": "4900", "image": "frn1le02ob03re2img01.jpg"}, {"text": "<span class=\"strong\">\u00c9mile</span> : Ma petite amie \u00e0 moi, elle parle chinois. Ses parents sont chinois. <br />\n<span class=\"strong\">Gr\u00e9goire</span> : Est-ce que tu parles chinois, toi ? <br />", "id": 3, "time": "7900", "image": "frn1le02ob03re2img01.jpg"}, {"text": "<span class=\"strong\">\u00c9mile</span> : Non, je ne parle pas chinois. Mais je parle japonais. J'emploie le japonais au travail. <br />\n<span class=\"strong\">Gr\u00e9goire</span> : Vraiment ? Qu'est-ce que tu fais comme boulot ? <br />", "id": 4, "time": "13500", "image": "frn1le02ob03re2img01.jpg"}, {"text": "<span class=\"strong\">\u00c9mile</span> : Je suis traducteur. <br />\n<span class=\"strong\">Gr\u00e9goire</span> : Super ! Je ne comprends absolument rien en japonais. <br />", "id": 5, "time": "21300", "image": "frn1le02ob03re2img01.jpg"}, {"text": "<span class=\"strong\">\u00c9mile</span> : Connais-tu l'expression \u00ab c'est du chinois pour moi \u00bb ? <br />\n<span class=\"strong\">Gr\u00e9goire</span> : Qu'est-ce que cela veut dire?<br />", "id": 6, "time": "26500", "image": "frn1le02ob03re2img01.jpg"}, {"text": "<span class=\"strong\">\u00c9mile</span> : Cela veut dire qu'on ne comprend rien. <br />\n<span class=\"strong\">Gr\u00e9goire</span> : Alors, quand tu parles japonais, c'est du chinois pour moi !  <br />", "id": 7, "time": "31000", "image": "frn1le02ob03re2img01.jpg"}], "audiosrc": "frn1le02ob03re2aud01", "coverimg": "frn1le02ob03re2img01.jpg"}, "type": "slideshow"}], "_data": [{"content": [], "type": "tips"}], "type": "audio", "template_override": 1}]}]}